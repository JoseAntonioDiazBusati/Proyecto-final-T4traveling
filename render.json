{
  "services": [
    {
      "type": "web",
      "name": "proyecto-final-t4traveling",
      "env": "static",
      "buildCommand": "cd frontend && npm ci --include=dev && npm run build:prod",
      "staticPublishPath": "./frontend/dist/t4traveling/browser",
      "envVars": [
        {
          "key": "NODE_VERSION",
          "value": "20.18.0"
        },
        {
          "key": "NPM_VERSION",
          "value": "10.9.2"
        }
      ],
      "routes": [
        {
          "type": "rewrite",
          "source": "/:path((?!.*\\.).*)",
          "destination": "/index.html"
        }
      ],
      "headers": [
        {
          "path": "/*",
          "name": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "path": "/*",
          "name": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "path": "/*",
          "name": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "path": "/*",
          "name": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "path": "/index.html",
          "name": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "path": "/*.js",
          "name": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        },
        {
          "path": "/*.css",
          "name": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
